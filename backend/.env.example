# Backend environment variables (Express + MongoDB)
# Copy to: backend/.env

# Server
NODE_ENV=development
PORT=5000

# Frontend URL(s) for CORS (comma-separated for multiple origins)
# If not set, CORS allows all origins (dev only).
FRONTEND_URL=http://localhost:5173

# Database
# Local MongoDB example:
# MONGO_URI=mongodb://127.0.0.1:27017/event-management
MONGO_URI=

# Auth
# Use a long random string in production.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Email (optional)
# If SMTP_HOST and SMTP_USER are NOT set, the app will fall back to an Ethereal test account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email "From" defaults (optional)
FROM_NAME=CDGI Administrator
FROM_EMAIL=noreply@cdgi.edu.in
