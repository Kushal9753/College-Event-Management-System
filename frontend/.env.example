# Frontend environment variables (Vite + React)
# Copy to: frontend/.env

# API URL (optional)
# NOTE: The frontend uses `VITE_API_URL` as axios baseURL.
# If you leave it empty, requests use `/api` which can be proxied via Vite.
VITE_API_URL=http://localhost:5000/api

# Socket URL (optional)
# If not set, the app will derive it from VITE_API_URL, else fallback to current origin.
VITE_SOCKET_URL=http://localhost:5000

# Vite dev proxy target (optional)
# Used only by Vite dev server proxy. If not set, it is derived from VITE_API_URL.
VITE_PROXY_TARGET=http://localhost:5000
